# SQLite database path. Defaults to forma.sqlite alongside server.js.
FORMA_DB=./forma.sqlite
# Local file-store root for validated business logos. Use managed object storage
# before deploying multi-tenant production workloads.
FORMA_UPLOAD_DIR=./uploads
# Local HTTP port. Defaults to 4173.
PORT=4173
# Local development stays unauthenticated unless explicitly enabled.
FORMA_AUTH_MODE=disabled
# Email is development-safe by default. "mock" records accepted_mock attempts only;
# it does not contact a provider or claim that a message was delivered.
FORMA_EMAIL_PROVIDER=mock
# Resend is supported when a verified sender and API key are configured. The generated
# PDF is attached and provider acceptance is recorded before the document becomes sent.
# Do not place production secrets in this local file.
# FORMA_EMAIL_PROVIDER=resend
# FORMA_RESEND_API_KEY=re_xxxxxxxxx
# FORMA_EMAIL_FROM="Forma <billing@example.com>"
# FORMA_RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Hosted payment links. Configure either or both providers and use their sandbox
# credentials locally. Webhook secrets are server-only.
# FORMA_PUBLIC_URL=http://localhost:4173
# FORMA_STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
# FORMA_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
# FORMA_PAYPAL_ENV=sandbox
# FORMA_PAYPAL_CLIENT_ID=xxxxxxxxx
# FORMA_PAYPAL_CLIENT_SECRET=xxxxxxxxx
# FORMA_PAYPAL_WEBHOOK_ID=xxxxxxxxx

# Protects POST /api/internal/run-operations. Use a long random value when a
# scheduler is configured; do not expose it to the browser.
# FORMA_CRON_SECRET=xxxxxxxxx

# Supabase target stack. The app still defaults to local SQLite in development;
# use supabase/migrations to create the hosted Postgres schema before the
# durable adapter cutover.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_ANON_KEY=ey... # Legacy projects only; publishable key is preferred.
# SUPABASE_SERVICE_ROLE_KEY=ey...
# SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
